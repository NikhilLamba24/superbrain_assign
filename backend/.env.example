# Supabase (Postgres + Storage + Realtime)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scene-images

# Together AI (server-side image generation)
TOGETHER_API_KEY=
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.2-dev
# TOGETHER_API_URL=https://api.together.ai/v1

# Local dev: set to true to generate a placeholder image instead of calling Together AI
TOGETHER_MOCK=false

# Active-session expiry in seconds (client heartbeats every ~10s)
SESSION_TTL_SECONDS=120

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
